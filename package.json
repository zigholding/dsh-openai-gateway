{
  "name": "dsh-openai-gateway",
  "version": "0.1.1",
  "description": "Expose DeepSeek Harness as an OpenAI-compatible API server: /v1/chat/completions (stream + non-stream) and /v1/models, each API call backed by a real agent session with tools and a workspace.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "keywords": ["dsh-plugin", "deepseek-harness", "openai", "openai-compatible", "api-gateway"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
